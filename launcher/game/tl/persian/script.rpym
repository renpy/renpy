# اسکریپت بازی در این فایل قرار می‌گیرد.

# تعریف شخصیت‌های استفاده شده توسط این بازی. آرگومان color نام شخصیت را
# رنگ‌آمیزی می‌کند.

define e = Character("ایلین")


# بازی اینجا شروع می‌شود.

label start:

    # نمایش یک پس‌زمینه. این به صورت پیش‌فرض از یک تصویر موقتی استفاده می‌کند،
    # ولی شما می‌توانید یک فایل (به نام "bg room.png" یا "bg room.jpg") به پوشهٔ
    # images اضافه کرده تا آن را نمایش دهید.

    scene bg room

    # این یک اسپرایت شخصیت را نمایش می‌دهد. یک تصویر موقتی استفاده شده، ولی شما
    # می‌توانید آن را با اضافه کردن یک فایل به نام "eileen happy.png" به پوشهٔ
    # images جایگزین کنید.

    show eileen happy

    # نمایش این خطوط دیالوگ.

    e "شما یک بازی جدید Ren'Py ساختید."

    e "وقتی یک داستان، تصاویر، و موسیقی اضافه کنید، می‌توانید به دنیا انتشار کنید!"

    # این بازی را تمام می‌کند.

    return
